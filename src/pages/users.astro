---
import AccountLayout from '../layouts/AccountLayout.astro';
import { listUsers } from '../lib/auth';
if (Astro.locals.user?.role !== 'admin')
  return new Response('Administrator access required', { status: 403 });
const users = await listUsers();
const current = Astro.locals.user!;
---

<AccountLayout title="Users & access" section="users">
  <p class="account-intro">
    Administrators manage this workspace. Viewers can browse services.
  </p>
  <details class="settings-advanced create-user">
    <summary>Create account</summary>
    <form class="account-form" method="post" action="/api/users">
      <input type="hidden" name="action" value="create" />
      <label>
        Username
        <input
          name="username"
          required
          minlength="3"
          maxlength="40"
          pattern="[a-z0-9][a-z0-9_.\-]{2,39}"
          autocomplete="off"
        />
      </label>
      <label>
        Temporary password
        <input
          type="password"
          name="password"
          autocomplete="new-password"
          required
          minlength="12"
          maxlength="128"
        />
        <small>Share privately. Users can change it after signing in.</small>
      </label>
      <label>
        Role
        <select name="role">
          <option value="viewer">Viewer</option>
          <option value="admin">Administrator</option>
        </select>
      </label>
      <button class="button primary">Create account</button>
    </form>
  </details>
  <h3>
    Accounts <span class="count">{users.length}</span>
  </h3>
  <div class="users-list">
    {users.map((user) => (
      <article class="user-entry">
        <div class="user-heading">
          <strong>
            {user.username}
            {current.id === user.id && ' (you)'}
          </strong>
          <span class="role-badge">{user.role}</span>
        </div>
        <details class="user-management">
          <summary>Manage account</summary>
          <form method="post" action="/api/users" class="inline-form">
            <input type="hidden" name="userId" value={user.id} />
            <input type="hidden" name="action" value="role" />
            <select
              name="value"
              aria-label={`Role for ${user.username}`}
              disabled={current.id === user.id}
            >
              <option value="viewer" selected={user.role === 'viewer'}>
                Viewer
              </option>
              <option value="admin" selected={user.role === 'admin'}>
                Administrator
              </option>
            </select>
            <button class="button" disabled={current.id === user.id}>
              Update role
            </button>
          </form>
          <form method="post" action="/api/users" class="inline-form">
            <input type="hidden" name="userId" value={user.id} />
            <input type="hidden" name="action" value="password" />
            <input
              type="password"
              name="value"
              autocomplete="new-password"
              required
              minlength="12"
              maxlength="128"
              aria-label={`New password for ${user.username}`}
              placeholder="New password (12+ characters)"
            />
            <button class="button">Reset password</button>
          </form>
          <div class="user-actions">
            <form method="post" action="/api/users">
              <input type="hidden" name="userId" value={user.id} />
              <button class="button" name="action" value="revoke">
                Revoke all sessions
              </button>
            </form>
            <form
              method="post"
              action="/api/users"
              onsubmit="return confirm('Delete this account and revoke all its sessions?')"
            >
              <input type="hidden" name="userId" value={user.id} />
              <button
                class="button danger"
                name="action"
                value="delete"
                disabled={current.id === user.id}
              >
                Delete account
              </button>
            </form>
          </div>
        </details>
      </article>
    ))}
  </div>
</AccountLayout>
