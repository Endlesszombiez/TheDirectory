---
import Files from '../components/Files';
import AppSidebar from '../components/AppSidebar';
import { readConfig } from '../lib/store';
import { readContainerManagers } from '../lib/container-managers';
import { Menu } from 'lucide-react';
import '../styles/global.css';
import '../styles/files.css';
const config = await readConfig();
const user = Astro.locals.user;
---

<!doctype html>
<html lang="en" data-theme={config.theme} data-accent={config.accent}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" href="/favicon.svg" />
    <title>Files · {config.title}</title>
  </head>
  <body>
    <div class:list={['app-shell', { 'files-guest': !user }]}>
      {user && (
        <>
          <button
            class="sidebar-scrim"
            id="files-scrim"
            aria-label="Close navigation"
            hidden
          />
          <aside class="sidebar" id="files-sidebar">
            <AppSidebar
              config={config}
              user={user}
              managers={readContainerManagers()}
              files
              client:load
            />
          </aside>
        </>
      )}
      <div class:list={{ 'main-shell': !!user }}>
        <header class="topbar">
          <div class="breadcrumb">
            {user && (
              <button
                class="icon-button mobile-toggle"
                id="files-menu"
                aria-label="Open navigation"
                aria-controls="files-sidebar"
                aria-expanded="false"
              >
                <Menu size={20} />
              </button>
            )}
            <a href={user ? '/' : '/files'}>{config.title}</a>
            <span>/</span>
            <span>Files</span>
          </div>
          {!user && (
            <a class="button" href="/login">
              Sign in
            </a>
          )}
        </header>
        <main>
          <Files client:load />
        </main>
      </div>
    </div>
    <script>
      const sidebar = document.getElementById('files-sidebar');
      const menu = document.getElementById('files-menu');
      const scrim = document.getElementById('files-scrim');
      const toggle = (open: boolean) => {
        sidebar?.classList.toggle('open', open);
        menu?.setAttribute('aria-expanded', String(open));
        if (scrim) scrim.hidden = !open;
      };
      menu?.addEventListener('click', () =>
        toggle(menu.getAttribute('aria-expanded') !== 'true'),
      );
      scrim?.addEventListener('click', () => toggle(false));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') toggle(false);
      });
    </script>
  </body>
</html>
