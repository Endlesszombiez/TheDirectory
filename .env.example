# Required only for first-run administrator creation. Password: 12–128 characters.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
# Public HTTPS address, no trailing slash. Must match the browser origin.
APP_ORIGIN=http://localhost:4321
# DATA_DIR=./data
# Optional initial Files PIN/password (4–128 characters). Admins can also set it at /files.
# Once saved in the UI, stored file settings take precedence over this value.
# FILES_PIN=
# Optional Apprise HTTP API endpoint, for example https://apprise.example/notify/mykey.
# FILES_APPRISE_URL=
# FILES_APPRISE_MESSAGE=New file uploaded {filename} ({size} bytes), Storage used {storage} bytes
# Compose uses its private restricted Docker proxy by default.
# DOCKER_SOCKET=/var/run/docker.sock
# Optional restricted Docker API proxy origin; takes precedence over DOCKER_SOCKET.
# DOCKER_API_URL=http://docker-proxy:2375
# For a direct socket override, explicitly set DOCKER_API_URL=

# Optional embedded container managers. Full browser-reachable HTTP(S) URLs.
# Restart TheDirectory after changing these. The target must allow iframe embedding.
# PORTAINER_HOME_URL=http://localhost:3333
# DOCKHAND_HOME_URL=http://localhost:3000

# Optional Render TLS syslog listener. Disabled unless RENDER_LOG_PORT is set.
# RENDER_LOG_PORT=6514
# RENDER_LOG_HOST=0.0.0.0
# Paths to a public-CA certificate chain and its private key (PEM).
# RENDER_LOG_TLS_CERT=/run/render-tls/fullchain.pem
# RENDER_LOG_TLS_KEY=/run/render-tls/privkey.pem
# Required comma-separated Render sender IPs/CIDRs; never use an unrestricted range.
# RENDER_LOG_ALLOWED_IPS=203.0.113.10/32
